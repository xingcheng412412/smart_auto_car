<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lawn_mower_console</name>
  <version>0.1.0</version>
  <description>SSH terminal console for mower recording and path tracking.</description>

  <maintainer email="lao@todo.todo">lao</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>can_client</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lawn_mower_recorder</exec_depend>
  <exec_depend>lawn_mower_tracker</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rtk_gps_driver_cpp</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
