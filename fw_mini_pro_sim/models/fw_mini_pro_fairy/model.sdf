    <link name="rslidar">
      <pose>0 0 0.483976069 0 0 0</pose>
      <inertial>
        <mass>0.35</mass>
        <inertia>
          <ixx>0.000266</ixx>
          <iyy>0.000266</iyy>
          <izz>0.000246</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 .035 0 0 0</pose>
      </inertial>
      <collision name="fairy_body">
        <pose>0 0 .035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0375</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="fairy_body_visual">
        <pose>0 0 .035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0375</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.15 .2 .25 1</ambient>
          <diffuse>.15 .2 .25 1</diffuse>
        </material>
      </visual>
      <sensor name="fairy" type="gpu_lidar">
        <pose>0 0 .035 0 0 0</pose>
        <topic>/fairy</topic>
        <gz_frame_id>fairy_optical</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1440</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>96</samples>
              <resolution>1</resolution>
              <min_angle>-0.2792526803190927</min_angle>
              <max_angle>0.2792526803190927</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>150</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <joint name="support_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_support</child>
    </joint>
    <joint name="lidar_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>rslidar</child>
    </joint>
