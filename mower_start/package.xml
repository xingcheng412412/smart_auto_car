<?xml version="1.0"?>
<package format="3">
  <name>mower_start</name>
  <version>0.1.0</version>
  <description>Whole vehicle bringup for CAN, RTK, recording and tracking.</description>
  <maintainer email="maintainer@example.com">Mower maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>can_client</exec_depend>
  <exec_depend>rtk_gps_driver_cpp</exec_depend>
  <exec_depend>lawn_mower_recorder</exec_depend>
  <exec_depend>lawn_mower_tracker</exec_depend>
  <exec_depend>lawn_mower_console</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
